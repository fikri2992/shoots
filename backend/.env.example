# Copy to backend/.env and fill in. Never commit .env.

# --- Gemini ---------------------------------------------------------------
# Pick ONE. Vertex is what the deployment uses; the API key is fine locally.
GOOGLE_API_KEY=
# USE_VERTEX_AI=true
# Gemini 3.x is served from the GLOBAL endpoint. The optional legacy Director's
# Veo call uses us-central1 and is outside the product loop.
VERTEX_LOCATION=global
MEDIA_LOCATION=us-central1

# --- Google Cloud ---------------------------------------------------------
GCP_PROJECT=
GCP_LOCATION=asia-southeast2
# CLOUD_STATE=true switches to Firestore + Secret Manager; GCS_BUCKET switches
# blobs to GCS. Either disables ALLOW_DEV_LOGIN. Leave both off to run locally.
CLOUD_STATE=false
GCS_BUCKET=

# Use a directory as the Drive folder (no Google needed). Empty = real Drive via
# the ingest service account below.
DRIVE_LOCAL_FOLDER=

# The identity that reads the Drive folder and runs the pipeline. Created by
# infra/state.sh; locally ADC impersonates it. Required unless DRIVE_LOCAL_FOLDER
# is set. infra/deploy.sh passes it into the Cloud Run service automatically.
DRIVE_SERVICE_ACCOUNT=

# Leave empty locally: pipeline stages chain in-process. On Cloud Run, set to the
# service URL so Pub/Sub push subscriptions can reach /pubsub/*.
PUBSUB_PUSH_BASE_URL=

# --- Google Drive ---------------------------------------------------------
# Must be public HTTPS for Drive to call it. Locally use an ngrok/cloudflared URL.
DRIVE_WEBHOOK_URL=http://localhost:8000/drive/notify

# --- Auth -----------------------------------------------------------------
# Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Redirect URI must exactly match OAUTH_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
ALLOW_DEV_LOGIN=false

# Shared secret for /tasks/* (Cloud Scheduler sends it as X-Tasks-Token).
TASKS_TOKEN=

# Web Push. Generate with scripts/vapid_keys.py; the public key goes to the PWA.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-contact@example.com
