# Copy to backend/.env and fill in. Never commit .env.

# --- Gemini ---------------------------------------------------------------
# Pick ONE. Vertex is what the deployment uses; the API key is fine locally.
GOOGLE_API_KEY=
# USE_VERTEX_AI=true
# Gemini 3.x is served from the GLOBAL endpoint only. Veo/Lyria: us-central1.
VERTEX_LOCATION=global
MEDIA_LOCATION=us-central1

# --- Google Cloud ---------------------------------------------------------
GCP_PROJECT=
GCP_LOCATION=asia-southeast2
# CLOUD_STATE=true switches to Firestore + Secret Manager; GCS_BUCKET switches
# blobs to GCS. Either disables ALLOW_DEV_LOGIN. Leave both off to run locally.
CLOUD_STATE=false
GCS_BUCKET=

# Use a directory as the Drive folder (no Google needed). Empty = real Drive via
# the shoots-ingest service account.
DRIVE_LOCAL_FOLDER=

# Leave empty locally: pipeline stages chain in-process. On Cloud Run, set to the
# service URL so Pub/Sub push subscriptions can reach /pubsub/*.
PUBSUB_PUSH_BASE_URL=

# --- Google Drive ---------------------------------------------------------
# Must be public HTTPS for Drive to call it. Locally use an ngrok/cloudflared URL.
DRIVE_WEBHOOK_URL=http://localhost:8000/drive/notify

# --- Auth -----------------------------------------------------------------
# Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Redirect URI must exactly match OAUTH_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback
FRONTEND_ORIGIN=http://localhost:5173
SESSION_SECRET=change-me-to-a-long-random-string
ALLOW_DEV_LOGIN=false

# Shared secret for /tasks/* (Cloud Scheduler sends it as X-Tasks-Token).
TASKS_TOKEN=
