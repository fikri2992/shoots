# Secrets — never commit
.env
*.env
!.env.example
*-key.json
service-account*.json

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/

# Built SPA copied into the image by the Dockerfile; also handy locally to serve
# the app from one origin without a vite proxy.
backend/static/

# Local blob storage (regenerated by scripts/seed_demo.py)
.blobs/

# Eval artifacts
eval/output/
eval/images/**/*
!eval/images/**/.gitkeep
eval/*.local.json

# OS
Thumbs.db
.DS_Store

# Demo media: real photos with EXIF, never committed
data/demo/

# Local agent/editor state and reproducible quality-run blob stores
.claude/
docs/test-corpus/results/*-assets/
docs/test-corpus/results/**/*-assets/
docs/test-corpus/results/finding-layer-debug.png
docs/screenshots/drive-picker-e2e.png
